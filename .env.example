# ==========================================
# Real-Time Network Monitoring & Threat Detection System
# Environment Configuration Template
# ==========================================

# 1. Server Configuration
HOST=0.0.0.0
PORT=5000
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# 2. Network Sniffer Configuration
# Leave empty for automatic default OS interface selection
SNIFFER_INTERFACE=
# Promiscuous mode: true / false
PROMISCUOUS_MODE=true
# Berkeley Packet Filter (BPF) syntax
BPF_FILTER=ip or arp
# Ingestion buffer capacity
BUFFER_QUEUE_SIZE=10000

# 3. Threat Detection Thresholds
PORT_SCAN_DISTINCT_PORTS=20
PORT_SCAN_WINDOW_SECONDS=5.0
SYN_FLOOD_RATE_PPS=100
SYN_ACK_RATIO_LIMIT=10.0
ICMP_FLOOD_RATE_PPS=50
BRUTE_FORCE_FAILED_LIMIT=15
BRUTE_FORCE_WINDOW_SECONDS=60.0
ALERT_COOLDOWN_SECONDS=30.0

# 4. Database (MongoDB) Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=network_monitor
MONGO_MAX_POOL_SIZE=50

# 5. Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 6. WebSocket Real-Time Gateway
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PACKET_STREAM_BATCH_MS=100
METRICS_UPDATE_INTERVAL_MS=1000

# 7. Frontend Environment (frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_WS_URL=http://localhost:5000
